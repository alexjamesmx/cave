# /etc/cave/offsite.env on the VPS: owner root, group cave, mode 640. Never commit the real file.
# The R2 bucket, through restic's S3 backend; <account> is the Cloudflare account id.
RESTIC_REPOSITORY=s3:https://<account>.r2.cloudflarestorage.com/cave-backups
# An R2 API token with Object Read & Write on cave-backups only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 has one region, "auto"; restic reads it from here (or -o s3.region=auto).
AWS_DEFAULT_REGION=auto
# Generated on the VPS with: openssl rand -base64 48 > /etc/cave/offsite.key
# Also kept in the owner's password manager: without it the copies can't be decrypted.
RESTIC_PASSWORD_FILE=/etc/cave/offsite.key
