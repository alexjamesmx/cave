{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["context7", "exa", "firecrawl", "github", "cave", "cave-dev"],
  "permissions": {
    "deny": [
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/.env.*.local)",
      "Read(/.env.production)",
      "Read(/data/**)",
      "Edit(/data/**)"
    ],
    "ask": ["Bash(git push *)", "Bash(git reset --hard *)", "Bash(git rebase *)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "git",
            "args": ["-C", "${CLAUDE_PROJECT_DIR}", "config", "core.hooksPath", ".githooks"]
          },
          {
            "type": "command",
            "command": "bun",
            "args": ["run", "--silent", "--cwd", "${CLAUDE_PROJECT_DIR}", "sync"],
            "timeout": 30
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
