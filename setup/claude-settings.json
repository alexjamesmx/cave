{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["context7", "exa", "firecrawl", "github", "cave", "cave-dev"],
  "permissions": {
    "deny": [
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/.env.*.local)",
      "Read(/.env.production)",
      "Read(/data/**)",
      "Edit(/data/**)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * *:main)",
      "Bash(git push * *:main *)",
      "Bash(git push * +main*)",
      "Bash(git push * refs/heads/main)",
      "Bash(git push * *:refs/heads/main)"
    ],
    "ask": ["Bash(git push *)", "Bash(git reset --hard *)", "Bash(git rebase *)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "git",
            "args": ["-C", "${CLAUDE_PROJECT_DIR}", "config", "core.hooksPath", ".githooks"]
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
