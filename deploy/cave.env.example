# /etc/cave/cave.env on the VPS: owner root, group cave, mode 640. Never commit the real file.
# The only value that delivers notifications; release.sh refuses to switch to a release without it.
CAVE_ENV=production
CAVE_DB_PATH=/var/lib/cave/cave.db
BACKUP_DIR=/var/lib/cave/backups
CAVE_PUBLIC_ORIGIN=https://cave.alexjamesmx.dev
# Generated on the VPS with: openssl rand -base64 48
CAVE_TOKEN=
PORT=3000
# Commands that source this file (restore, agent add) write no cache into /var/lib/cave.
BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
# Web Push: all three or none. bun run push-keys appends them (docs/hosting.md, "Web Push").
CAVE_VAPID_PUBLIC=
CAVE_VAPID_PRIVATE=
CAVE_VAPID_SUBJECT=
# Telegram bot from @BotFather, and a Discord channel webhook. Secrets: never logged or shown.
CAVE_TELEGRAM_BOT_TOKEN=
CAVE_DISCORD_WEBHOOK_URL=
# Written by cave-deploy; Settings shows the last deploy from it.
CAVE_DEPLOY_STATUS=/var/lib/cave-deploy/status.json
# Written by cave-offsite; /system and Settings show the off-box backup, and it alerts when stale.
CAVE_OFFSITE_STATUS=/var/lib/cave-offsite/status.json
