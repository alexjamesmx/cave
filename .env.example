# Copy to .env (git-ignored); Bun loads it on every start. Empty means the default.

# HTTP port. Empty: 3000.
PORT=
# Where backups go. Empty: data/backups. Backups hold everything, so keep them private.
BACKUP_DIR=
# Bearer token devices send to /api. Required when the server listens beyond loopback.
CAVE_TOKEN=

# Hosting (docs/hosting.md). On the VPS these live in /etc/cave/cave.env instead.
# The https origin browsers use behind the reverse proxy. Requires CAVE_TOKEN (32+ characters in production).
CAVE_PUBLIC_ORIGIN=

# Laptop only: bun run deploy, pull-data and money-review.
# SSH destination of the VPS. Empty: cave-vps (an entry in ~/.ssh/config).
CAVE_SSH=
# Public URL of the hosted server, e.g. https://cave.example.dev
CAVE_REMOTE_URL=
# The hosted server's CAVE_TOKEN, for the deploy health check.
CAVE_REMOTE_TOKEN=
# Folder that receives backups pulled from the VPS.
BACKUP_PULL_DIR=

# Email through Resend (docs/hosting.md step 12): all three together, or none and the channel is off.
# A Resend API key with sending access.
CAVE_RESEND_API_KEY=
# The sender, on a domain verified in Resend: Cave <cave@cave.example.dev>
CAVE_EMAIL_FROM=
# Your inbox.
CAVE_EMAIL_TO=
