# Copy to .env (git-ignored); Bun loads it on every start. Empty means the default.

# Obsidian vault to import from, read-only. Empty: no import.
VAULT_PATH=
# HTTP port. Empty: 3000.
PORT=
# Where backups go. Empty: data/backups. Backups hold everything, so keep them private.
BACKUP_DIR=
# Bearer token devices send to /api. Required when the server listens beyond loopback.
CAVE_TOKEN=
